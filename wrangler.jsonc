{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doctor-sonrisa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Served on your workers.dev subdomain; no preview URLs of old versions
  "workers_dev": true,
  "preview_urls": false,
  // The clinic's page and chat; /api/* goes to the Worker
  "assets": { "directory": "public", "run_worker_first": ["/api/*"] },
  // Patients, appointments, users, sessions, counters and logs. "wrangler dev"
  // uses a local copy, so the placeholder id works locally. Before deploying,
  // run "pnpm exec wrangler d1 create doctor-sonrisa" and paste the
  // "database_id" it prints here.
  "d1_databases": [
    { "binding": "DB", "database_name": "doctor-sonrisa", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "db/migrations" }
  ],
  // RAG: embeddings with bge-m3 and the "doctor-sonrisa" index (1024 dimensions, cosine).
  // Both run on Cloudflare even in "wrangler dev" ("remote": true).
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "doctor-sonrisa", "remote": true }]
  // Secrets: GROQ_API_KEY ("wrangler secret put GROQ_API_KEY"; locally in .dev.vars)
}
