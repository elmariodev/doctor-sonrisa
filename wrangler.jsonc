{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doctor-sonrisa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Live at doctor-sonrisa.elmariodev.workers.dev; no preview URLs of old versions
  "workers_dev": true,
  "preview_urls": false,
  // The clinic's page and chat; /api/* goes to the Worker
  "assets": { "directory": "public", "run_worker_first": ["/api/*"] },
  // Patients, appointments, users and sessions. Local in development; the id is
  // the deployed database ("wrangler d1 create doctor-sonrisa" for your own).
  "d1_databases": [
    { "binding": "DB", "database_name": "doctor-sonrisa", "database_id": "215eaa30-9ade-435c-a40c-d27f6695f088", "migrations_dir": "db/migrations" }
  ],
  // RAG: embeddings with bge-m3 and the "doctor-sonrisa" index (1024 dimensions, cosine).
  // Both run on Cloudflare even in "wrangler dev" ("remote": true).
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "doctor-sonrisa", "remote": true }]
  // Secrets: GROQ_API_KEY ("wrangler secret put GROQ_API_KEY"; locally in .dev.vars)
}
